{
  "name": "couch",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "backend": "node backend/server.js",
    "remote:prepare": "node scripts/prepare-remote.mjs",
    "remote:dev": "pnpm remote:prepare && vite --config vite.config.js",
    "remote:build": "pnpm remote:prepare && vite build --config vite.config.js",
    "extension:build-qr": "vite build --config qr.config.js",
    "package": "node --env-file-if-exists=.env scripts/package.mjs",
    "release": "node scripts/release.mjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "frontend:dev": "pnpm --dir frontend dev",
    "frontend:build": "pnpm --dir frontend build",
    "frontend:preview": "pnpm --dir frontend preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.23.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
