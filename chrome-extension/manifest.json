{
  "manifest_version": 3,
  "name": "Couch",
  "version": "1.11",
  "description": "Real-time synchronized video playback and chat.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Show or hide Couch",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/couch.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}