{
  "manifest_version": 3,
  "name": "Couch",
  "version": "1.0",
  "description": "Real-time synchronized video playback and chat.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://cinejoy.pk/*",
    "https://*.cinejoy.pk/*",
    "https://cinegram.tv/*",
    "https://*.cinegram.tv/*"
  ],
  "action": {
    "default_title": "Show or hide Couch"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://cinejoy.pk/*",
        "https://*.cinejoy.pk/*",
        "https://cinegram.tv/*",
        "https://*.cinegram.tv/*"
      ],
      "js": ["keyboard-guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://cinejoy.pk/*",
        "https://*.cinejoy.pk/*",
        "https://cinegram.tv/*",
        "https://*.cinegram.tv/*"
      ],
      "js": ["socket.io.js", "content.js"],
      "run_at": "document_end"
    }
  ]
}